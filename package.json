    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "omggif": "^1.0.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.12",
    "topojson-client": "^3.1.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
