# ==========================================
# 🔒 보안 및 환경 변수 가이드라인 (SECURITY GUIDELINES)
# ==========================================
# 1. [서버 전용 환경 변수] 
# 브라우저(클라이언트)에 절대 노출되면 안 되는 API 키, 시크릿 등은
# 'VITE_' 접두어 없이 선언합니다. Node.js 백엔드(server.ts)에서만 접근 가능합니다.
PORT=3000
HOST=0.0.0.0
KMA_AUTH_KEY=
WEBHOOK_URL=
SSL_KEY_PATH=
SSL_CERT_PATH=
SSL_CA_PATH=

# 2. [클라이언트 노출 환경 변수]
# 프론트엔드(React)에서 직접 접근해야 하는 환경 변수는 반드시 'VITE_' 접두어를 붙입니다.
# (예: import.meta.env.VITE_PUBLIC_API_URL)
# 절대 이곳에 비밀번호나 인증 키를 하드코딩하지 마세요.
# VITE_PUBLIC_API_URL=https://api.example.com